# ==============================================================================
# StreamIT Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=

# MongoDB Connection String (Local or MongoDB Atlas)
# Example: mongodb://localhost:27017/streamit
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/streamit?retryWrites=true&w=majority
MONGO_URI=
# JWT Secret for Authentication
JWT_SECRET=

# AWS S3 Configuration (Used for multipart video uploads and presigned streaming URLs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=